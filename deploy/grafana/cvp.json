{
 "title": "Content visibility platform",
 "uid": "cvp-slo",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Feed and search requests / s",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(cvp_http_request_seconds_count{route=~\"feed|search\"}[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error ratio against the 0.1% budget",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "cvp:error_ratio:rate5m",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p99 latency by route",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, route) (rate(cvp_http_request_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Listing events visible within 5 s (SLO 99%)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "cvp:fresh_ratio:rate5m",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Materializer lag (records)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "cvp_consumer_lag_records",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Policy rollout: activation to last index write, p99",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(cvp_policy_apply_seconds_bucket[1h])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Index writes by kind / s",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    }
   },
   "targets": [
    {
     "expr": "sum by (kind) (rate(cvp_index_writes_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Active policy version",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    }
   },
   "targets": [
    {
     "expr": "cvp_policy_version",
     "refId": "A"
    }
   ]
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 }
}